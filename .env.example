APP_NAME=Podblender
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local

# Live updates on the feed page when a clip finishes processing. Run
# "php artisan reverb:install" to fill in the credentials below; leaving them
# empty means the feed page won't refresh itself.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Port the dev server ("php artisan dev") binds to, and that ngrok tunnels to.
SERVER_PORT=8000

# ngrok static domain assigned to this account (leave empty to get a random URL).
NGROK_HOST=

# The ngrok agent, looked up on PATH unless given as a path. "php artisan dev"
# only starts a tunnel when this resolves to an installed binary, so leaving
# ngrok uninstalled simply drops the tunnel rather than breaking the command.
# NGROK_BINARY=ngrok

# In-browser MP3 preview on the feed page. Only enabled when the default disk
# is a local/public disk; set to false to disable regardless of disk.
AUDIO_PREVIEW_ENABLED=true

QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Generative Language API key (aistudio.google.com/apikey). Narrates web
# articles and RSS items, so it's required for those sources.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Aoede

# Required to add YouTube videos, channels, or playlists.
YOUTUBE_DATA_API_KEY=

# Optional. Only used to reach articles behind a paywall, and every scrape
# spends credits; without it, gated articles just fail to extract.
SCRAPFLY_API_KEY=

# Optional residential proxy, used as a fallback when a download is refused.
# OXYLABS_USERNAME=
# OXYLABS_PASSWORD=
# OXYLABS_COUNTRY=US

# OpenAI is kept as an alternative TTS backend (App\Apis\Tts\OpenAiClient) but
# isn't the bound one, so these are only needed if you rebind it.
# OPENAI_API_KEY=
# OPENAI_ORGANIZATION=

# How far back, in months, a new subscription reaches when it's first filled in.
SUBSCRIPTION_BACKFILL_MONTHS=1

# Minutes to leave between one clip download and the next. Raise it if downloads
# start failing; lower it if a new subscription takes too long to fill in.
MINUTES_BETWEEN_DOWNLOADS=2
