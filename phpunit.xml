<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Tests">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="ALLOWED_REGISTRATION_EMAILS" value=""/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>

        <!--
            Credentials for every external service, faked. These exist so the
            suite never reads a developer's real keys, and so behaviour doesn't
            depend on which keys happen to be present in someone's .env: code
            paths branch on whether a key is configured, so a machine with no
            Scrapfly key took a different route through the article cascade and
            failed, while a machine with one passed. Dotenv is immutable, so
            these win over .env.

            Nothing here is a real credential and nothing here is dialled: the
            HTTP layer is faked in the tests that reach these services.
        -->
        <env name="OXYLABS_USERNAME" value="testing-user"/>
        <env name="OXYLABS_PASSWORD" value="testing-password"/>
        <env name="OXYLABS_COUNTRY" value="US"/>
        <env name="SCRAPFLY_API_KEY" value="testing-key"/>
        <env name="YOUTUBE_DATA_API_KEY" value="testing-key"/>
        <env name="GEMINI_API_KEY" value="testing-key"/>
        <env name="OPENAI_API_KEY" value="testing-key"/>
    </php>
</phpunit>
