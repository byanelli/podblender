{
    "name": "byanelli/podblender",
    "type": "project",
    "description": "Turn audio from around the web into a private podcast feed: YouTube videos and channels, web articles narrated by text-to-speech, and RSS feeds.",
    "keywords": ["podcast", "rss", "youtube", "text-to-speech", "laravel"],
    "license": "Elastic-2.0",
    "require": {
        "php": "^8.5",
        "ext-zip": "*",
        "byanelli/ngrok-integration": "dev-main",
        "byanelli/roma": "dev-main",
        "fivefilters/readability.php": "^3.3",
        "guzzlehttp/guzzle": "^7.2",
        "inertiajs/inertia-laravel": "^3.0",
        "laminas/laminas-feed": "^2.26",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.30",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/uri": "^7.0",
        "openai-php/laravel": "^0.20.0",
        "spatie/regex": "^3.1",
        "tightenco/ziggy": "^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "kitloong/laravel-migrations-generator": "^7.0.3",
        "larastan/larastan": "^3.10",
        "laravel/breeze": "^2.0",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Concerns\\": "database/concerns/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php ./scripts/install-yt-dlp.php",
            "@php ./scripts/install-ffmpeg.php",
            "@php ./scripts/install-deno.php",
            "@php ./scripts/install-bgutil-pot.php"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "test": [
            "./vendor/bin/phpunit"
        ],
        "coverage": "php -d pcov.enabled=1 ./vendor/bin/phpunit --coverage-text",
        "pint": [
            "./vendor/bin/pint"
        ],
        "analyse": "./vendor/bin/phpstan analyse --memory-limit=1G",
        "quality": [
            "@composer run test",
            "@composer run analyse",
            "@composer run pint"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [{
        "name": "roma",
        "type": "vcs",
        "url": "https://github.com/byanelli/roma"
    }, {
        "name": "ngrok-integration",
        "type": "vcs",
        "url": "https://github.com/byanelli/ngrok-integration"
    }]
}
